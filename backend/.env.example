# 配置模板 —— 复制成 backend/.env 后填入自己的 key(.env 已被 .gitignore 忽略)
#
#   cp backend/.env.example backend/.env
#
# ⚠️ 改完必须**重启后端**才生效 —— 环境变量在进程启动时读取。
#    改文件对已在运行的服务没有任何影响,这是"token 换了却还是 401"最常见的原因。

# mock = 只解析偏好、不排程(离线可看 UI);deepseek = 调真实模型(也接受 llm / openai)
LLM_PROVIDER=deepseek

# 必填。任何 OpenAI 兼容端点的 key
LLM_API_KEY=sk-xxxx

# 端点。留空默认 https://api.deepseek.com(路径 /chat/completions 会被追加)
# 任意 OpenAI 兼容网关示例:https://your-gateway.example/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型。注意 deepseek-chat 是**别名,静默指向 flash**;想用 Pro 必须显式写 deepseek-v4-pro
LLM_MODEL=deepseek-flash

# 软偏好自评的单独超时(秒),默认 20。
# 20 是按快模型定的(快模型约 1s);DeepSeek 同规模载荷约 39s,不调大会
# **静默**超时 —— 不报错,只是公平页的软偏好整列变「未评估」。慢模型请设 60。
LLM_ASSESS_TIMEOUT=20

# 显式传的环境变量优先于 .env,临时压测/切换不用改文件:
#   LLM_MODEL=deepseek-v4-pro python -m uvicorn app.main:app --reload   (端口用默认 8000)
